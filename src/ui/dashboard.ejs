    <main class="dash-shell" id="resourcePanel">
      <header class="dash-header">
        <div class="dash-title-group">
          <span
            class="dash-status-dot"
            id="dashStatusDot"
            aria-hidden="true"
          ></span>
          <h1 class="dash-title">Network Insight Dashboard</h1>
          <span class="dash-updated" id="dashLastUpdated">Loading…</span>
        </div>
        <div class="dash-header-right">
          <div class="dash-legend" aria-label="Chart status legend">
            <span class="legend-item"
              ><span class="legend-swatch active"></span>Active</span
            >
            <span class="legend-item"
              ><span class="legend-swatch inactive"></span>Inactive</span
            >
            <span class="legend-item"
              ><span class="legend-swatch empty"></span>No Data</span
            >
          </div>
          <div class="dash-fleet-pill" id="dashFleetSummary">
            Assets: 0 · 0% Active
          </div>
          <button
            type="button"
            class="dash-refresh-btn"
            id="dashRefreshBtn"
            accesskey="@"
            onclick="fetchStats();"
            title="Refresh statistics"
          >
            <i class="fa fa-refresh" aria-hidden="true"></i>
            <span>Refresh</span>
          </button>
        </div>
      </header>

      <section
        class="dash-kpi-grid"
        id="businessMetricsPanel"
        aria-label="Business metrics"
      >
        <div class="kpi-card">
          <div class="kpi-icon premises">
            <i class="fa fa-home" aria-hidden="true"></i>
          </div>
          <div class="kpi-body">
            <div class="kpi-label">Premises Passed</div>
            <div class="kpi-value" id="kpiPremisesPassed">0</div>
            <div class="kpi-sub">Active trench reach</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon trench">
            <i class="fa fa-arrows-h" aria-hidden="true"></i>
          </div>
          <div class="kpi-body">
            <div class="kpi-label">Trench Coverage</div>
            <div class="kpi-value" id="kpiTrenchCoverage">0 m</div>
            <div class="kpi-sub">Total active distance</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon cable">
            <i class="fa fa-plug" aria-hidden="true"></i>
          </div>
          <div class="kpi-body">
            <div class="kpi-label">Cable Coverage</div>
            <div class="kpi-value" id="kpiCableCoverage">0 m</div>
            <div class="kpi-sub">Total deployed distance</div>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon cost">
            <i class="fa fa-money" aria-hidden="true"></i>
          </div>
          <div class="kpi-body">
            <div class="kpi-label">Total Asset Cost</div>
            <div class="kpi-value" id="kpiTotalCost">0.00</div>
            <div class="kpi-sub" id="kpiCurrencySubtitle">Configured currency</div>
          </div>
        </div>
      </section>

      <section
        class="dash-resources-section"
        id="resourceGraph"
        aria-label="Resource availability"
      >
        <div class="section-bar">
          <div class="section-heading">
            <i class="fa fa-pie-chart" aria-hidden="true"></i>
            <span>Resources · Active vs. Inactive</span>
          </div>
          <div class="platform-pills" id="dashPlatformPills"></div>
        </div>
        <div class="resource-pie-grid" id="resourcePieGrid"></div>
      </section>

      <section
        class="dash-costs-section"
        id="businessCostsPanel"
        aria-label="Asset cost breakdown"
      >
        <div class="costs-header">
          <div class="section-heading">
            <i class="fa fa-credit-card" aria-hidden="true"></i>
            <span>Cost Breakdown</span>
            <span class="costs-currency-badge" id="costsCurrencyBadge"
              >Currency</span
            >
          </div>
          <div class="costs-total-readout" id="costsTotalReadout">
            Total: <strong>0.00</strong>
          </div>
        </div>
        <div class="costs-grid" id="costsGrid"></div>
      </section>
    </main>

    <div class="dash-tooltip" id="dashTooltip" role="tooltip"></div>

    <div class="footer">
      <p>© 2026 Cowdrey Consulting. All rights reserved.</p>
    </div>
    <script defer="defer" src="/ni/js/ni-dashboard.js"></script>
  </body>
</html>
